  "scripts": {
    "test": "node --test agents/purchasing/tests/*.test.js apps/purchasing-web-backend/tests/*.test.js agents/arthur-core/tests/*.test.js agents/arthur-v1/tests/*.test.js agents/business-kpi/tests/*.test.js apps/business-kpi-web/tests/*.test.js",
