    "business-kpi:web": "node apps/business-kpi-web/server.js",
    "business-kpi:migrate": "node apps/business-kpi-web/storage/run-migrations.js",
    "finance:update:miska": "node scripts/update-miska-financial-data.js",
    "finance:check:miska": "node scripts/update-miska-financial-data.js --check",
    "purchasing:run": "node scripts/run-purchasing-agent.js",
    "purchasing:diagnostics": "node scripts/diagnose-purchasing-workbook.js",
    "purchasing:compare": "node scripts/compare-purchasing-workbooks.js",
    "purchasing:matrix:build": "node scripts/build-purchasing-matrix.js",
    "purchasing:web": "node apps/purchasing-web-backend/server.js"
  },
