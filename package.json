    "test:business-kpi": "node --test agents/business-kpi/tests/*.test.js apps/business-kpi-web/tests/*.test.js",
    "test:business-kpi:integration": "node --test apps/business-kpi-web/tests/http.test.js apps/business-kpi-web/tests/workbook_import_service.test.js",
