        "method": "POST",
        "url": "http://arthur-api:8787/v1/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-Arthur-Actor-Id", "value": "n8n" },
            { "name": "X-Arthur-Actor-Type", "value": "system" },
            { "name": "X-Correlation-Id", "value": "={{ $json.correlationId }}" }
          ]
