        "jsCode": "const body = $json.body ?? $json;\nconst title = String(body.title ?? '').trim();\nif (!title) throw new Error('Поле title обязательно');\nconst allowedDomains = ['personal','health','travel','content','business','purchasing','academy','finance','system'];\nconst domain = allowedDomains.includes(body.domain) ? body.domain : 'personal';\nreturn [{ json: { ownerId: 'sergey', domain, title, description: body.description ?? null, priority: body.priority ?? 'normal', dueAt: body.dueAt ?? null, sourceType: 'n8n', sourceRef: body.sourceRef ?? 'webhook:arthur-create-task', correlationId: body.correlationId ?? `n8n-${Date.now()}` } }];"
      },
      "id": "normalize-task",
      "name": "Проверить данные",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
