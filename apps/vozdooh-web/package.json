    "react-dom": "19.2.4",
    "three": "0.186.1",
    "three-stdlib": "2.36.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.186.0",
    "eslint": "9.34.0",
    "eslint-config-next": "16.3.3",
    "typescript": "5.9.2"
  }
