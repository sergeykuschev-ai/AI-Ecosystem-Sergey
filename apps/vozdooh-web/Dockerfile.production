FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VCS_REF=unknown
ARG NEXT_PUBLIC_SITE_URL=https://vozdooh27.ru
ARG NEXT_PUBLIC_YANDEX_METRICA_ID=113378472
ARG SEARCH_INDEXING_ENABLED=true

ENV NODE_ENV=production
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_YANDEX_METRICA_ID=${NEXT_PUBLIC_YANDEX_METRICA_ID}
ENV SEARCH_INDEXING_ENABLED=${SEARCH_INDEXING_ENABLED}

RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app

ARG VCS_REF=unknown
LABEL org.opencontainers.image.source="https://github.com/sergeykuschev-ai/AI-Ecosystem-Sergey"
LABEL org.opencontainers.image.revision="${VCS_REF}"
LABEL org.opencontainers.image.title="VOZDOOH storefront runtime"

ENV NODE_ENV=production
COPY --from=build /app /app

CMD ["./node_modules/.bin/next", "start", "--hostname", "0.0.0.0", "--port", "3411"]
