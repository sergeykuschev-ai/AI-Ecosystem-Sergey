# Public origin used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host interface used by Caddy for public 80/443. Production may bind a specific public IP.
CADDY_BIND_IP=0.0.0.0

# Server-only Directus connection. Docker Compose overrides the host to `directus`.
CONTENT_SOURCE=mock
DIRECTUS_URL=http://localhost:8055
DIRECTUS_SERVER_TOKEN=

# Admin token for schema apply and seed scripts. Not used by the Next.js app runtime.
# Create a static admin token in Directus or use the bootstrap administrator token.
DIRECTUS_ADMIN_TOKEN=

# Directus bootstrap credentials. Replace every placeholder before first start.
DIRECTUS_ADMIN_EMAIL=admin@example.invalid
DIRECTUS_ADMIN_PASSWORD=replace-with-a-strong-password
DIRECTUS_KEY=replace-with-at-least-32-random-characters
DIRECTUS_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL credentials used only inside the Docker network.
POSTGRES_DB=stores_cms
POSTGRES_USER=stores_cms
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# 1C CommerceML catalog exchange. Disabled by default.
ONEC_EXCHANGE_ENABLED=false
ONEC_EXCHANGE_USERNAME=
ONEC_EXCHANGE_PASSWORD=
ONEC_EXCHANGE_STORAGE_DIR=/var/lib/onec-exchange
ONEC_EXCHANGE_FILE_LIMIT=5242880
ONEC_EXCHANGE_MAX_FILE_SIZE=268435456

# Optional: IndexNow remains inactive until both values are configured.
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
