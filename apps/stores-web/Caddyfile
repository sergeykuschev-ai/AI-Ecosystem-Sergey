amurskmarket.ru {
    handle /api/1c/exchange* {
        reverse_proxy onec-sync:8080
    }

    handle /api/vozdooh-1c/exchange* {
        uri replace /api/vozdooh-1c/exchange /api/1c/exchange
        reverse_proxy vozdooh-onec-exchange:8080
    }

    handle {
        reverse_proxy web:3000
    }
}

www.amurskmarket.ru {
    redir https://amurskmarket.ru{uri} permanent
}

