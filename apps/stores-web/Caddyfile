amurskmarket.ru {
    # zstd for modern browsers, gzip as fallback; static compression at the
    # edge instead of on-the-fly gzip in the Node server.
    encode zstd gzip
    reverse_proxy web:3000
}

www.amurskmarket.ru {
    redir https://amurskmarket.ru{uri} permanent
}

cms.amurskmarket.ru {
    reverse_proxy directus:8055
}
