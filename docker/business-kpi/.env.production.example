# scopes:["onec:read","onec:write"]. Example contains placeholders only:
# BUSINESS_KPI_SERVICE_KEYS=[{"id":"onec-amursk","key":"replace-with-random-secret","scopes":["onec:read","onec:write"]}]
BUSINESS_KPI_SERVICE_KEYS=[]
ARTHUR_SERVICES_NETWORK=arthur_services

