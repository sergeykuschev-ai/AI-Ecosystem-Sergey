# Copy to .env before local startup and replace both values with strong unique secrets.
ARTHUR_POSTGRES_PASSWORD=change-this-local-password
ARTHUR_API_TOKEN=change-this-long-random-api-token

# Shared Docker network used only by Arthur Core API and n8n.
ARTHUR_N8N_NETWORK=arthur_n8n

# Arthur Telegram Gateway
# Get token from @BotFather.
TELEGRAM_BOT_TOKEN=replace-with-real-bot-token
# Comma-separated Telegram user IDs allowed to talk to Arthur.
TELEGRAM_ALLOWED_USER_IDS=replace-with-owner-telegram-user-id
# Optional: long-polling timeout in ms (default 30000).
# TELEGRAM_POLL_TIMEOUT_MS=30000
# Optional: health server port (default 8788).
# TELEGRAM_GATEWAY_HEALTH_PORT=8788

# Optional: proxy for Telegram API outbound requests.
# HTTP_PROXY=http://host.docker.internal:8443
# HTTPS_PROXY=http://host.docker.internal:8443
# NO_PROXY=localhost,127.0.0.1,postgres,api,arthur-api
