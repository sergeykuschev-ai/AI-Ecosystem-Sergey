# Copy to .env before local startup and replace both values with strong unique secrets.
ARTHUR_POSTGRES_PASSWORD=change-this-local-password
ARTHUR_API_TOKEN=change-this-long-random-api-token

# Shared Docker network used only by Arthur Core API and n8n.
ARTHUR_N8N_NETWORK=arthur_n8n

# Arthur Telegram Gateway
# Get token from @BotFather.
TELEGRAM_BOT_TOKEN=replace-with-real-bot-token
# The single Telegram user ID allowed to talk to Arthur.
TELEGRAM_ALLOWED_USER_IDS=replace-with-owner-telegram-user-id
# Canonical Arthur profile for the allowed Telegram owner.
ARTHUR_OWNER_PROFILE_ID=sergey
# Internal read-only Arthur Core connection for the Gateway.
ARTHUR_CORE_BASE_URL=http://api:8787
# Compose exposes ARTHUR_API_TOKEN to the Gateway as ARTHUR_CORE_TOKEN.
# Optional: Core request timeout in ms (default 5000).
# ARTHUR_CORE_TIMEOUT_MS=5000
# Optional: long-polling timeout in ms (default 30000).
# TELEGRAM_POLL_TIMEOUT_MS=30000
# Optional: health server port (default 8788).
# TELEGRAM_GATEWAY_HEALTH_PORT=8788

# Optional: proxy for Telegram API outbound requests.
# HTTP_PROXY=http://host.docker.internal:8443
# HTTPS_PROXY=http://host.docker.internal:8443
# NO_PROXY=localhost,127.0.0.1,postgres,api,arthur-api

# Arthur Purchasing run registry read-only mount.
# Default matches the read-only Docker volume in compose.yml.
# PURCHASING_RUNS_ROOT=/opt/arthur/output/purchasing-web/runs

# Arthur Mail: real Yandex IMAP remains disabled until a controlled setup.
ARTHUR_MAILBOX_MISKA_YANDEX_ENABLED=false
ARTHUR_MAILBOX_MISKA_YANDEX_ID=miska-yandex
ARTHUR_MAILBOX_MISKA_YANDEX_PROVIDER=yandex
ARTHUR_MAILBOX_MISKA_YANDEX_ACCOUNT_TYPE=work
ARTHUR_MAILBOX_MISKA_YANDEX_BUSINESS_CONTEXT=miska
ARTHUR_MAILBOX_MISKA_YANDEX_DISPLAY_NAME=Почта Миски
ARTHUR_MAILBOX_MISKA_YANDEX_IMAP_HOST=imap.yandex.ru
ARTHUR_MAILBOX_MISKA_YANDEX_IMAP_PORT=993
ARTHUR_MAILBOX_MISKA_YANDEX_IMAP_TLS=true
ARTHUR_MAILBOX_MISKA_YANDEX_IMAP_FOLDER=INBOX
# Credentials are never environment values. These optional Compose source paths
# must point to local files outside Git before enabling the mailbox.
# ARTHUR_MAILBOX_MISKA_YANDEX_USERNAME_SECRET_SOURCE=C:/secure/arthur/miska-yandex-username
# ARTHUR_MAILBOX_MISKA_YANDEX_APP_PASSWORD_SECRET_SOURCE=C:/secure/arthur/miska-yandex-app-password

# Arthur AI Provider (omniroute or fake).
# ARTHUR_AI_PROVIDER=omniroute
# OMNIROUTE_BASE_URL=http://omniroute:20128/v1
# OMNIROUTE_API_KEY=replace-with-omniroute-api-key
# OMNIROUTE_FAST_MODEL=arthur-fast
# OMNIROUTE_REASONING_MODEL=arthur-fast
# OMNIROUTE_CODE_MODEL=arthur-fast

# Arthur Business KPI read-only integration.
# BUSINESS_KPI_BASE_URL=http://business-kpi-web:3220
# BUSINESS_KPI_SERVICE_KEYS=[{"id":"arthur.analytics","name":"Arthur Analytics","key":"replace-with-long-random-service-key"}]
# BUSINESS_KPI_SERVICE_ID=arthur.analytics
# BUSINESS_KPI_REQUEST_TIMEOUT_MS=10000
