FROM node:22-alpine AS runtime

ENV NODE_ENV=production
WORKDIR /opt/arthur

RUN addgroup -S arthur && adduser -S -G arthur arthur

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

COPY agents/arthur-v1 ./agents/arthur-v1
COPY agents/purchasing ./agents/purchasing
COPY apps/purchasing-web-backend ./apps/purchasing-web-backend
COPY shared ./shared
COPY scripts ./scripts
COPY tests/fixtures ./tests/fixtures
COPY data ./data
COPY docs ./docs
COPY knowledge ./knowledge

USER arthur

EXPOSE 8788

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8788/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "agents/arthur-v1/telegram/start.js"]
