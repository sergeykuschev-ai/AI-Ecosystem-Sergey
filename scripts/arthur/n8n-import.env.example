# URL открытого интерфейса/API n8n, без завершающего слеша
N8N_BASE_URL=https://n8n.example.ru

# API key: n8n -> Settings -> API
N8N_API_KEY=replace-with-local-secret

# ID уже созданного Header Auth credential «Arthur Core API Token»
N8N_ARTHUR_CREDENTIAL_ID=replace-with-credential-id

# ID уже созданного Telegram credential
N8N_TELEGRAM_CREDENTIAL_ID=replace-with-credential-id

# Личный Telegram chat ID Сергея
N8N_TELEGRAM_CHAT_ID=replace-with-chat-id

# false — только загрузить, не активировать. По умолчанию true.
N8N_ACTIVATE_WORKFLOWS=true
