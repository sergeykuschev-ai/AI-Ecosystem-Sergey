# URL открытого интерфейса/API n8n, без завершающего слеша
N8N_BASE_URL=https://n8n.example.ru

# API key: n8n -> Settings -> API
N8N_API_KEY=replace-with-local-secret

# ID уже созданного Header Auth credential «Arthur Core API Token»
N8N_ARTHUR_CREDENTIAL_ID=replace-with-credential-id

# Импортировать только первый production workflow. Обычный importer оставляет
# workflow выключенным; Fixed MinMax делегируется published deploy-скрипту.
ARTHUR_N8N_WORKFLOW=arthur-create-task-production

# Следующие параметры нужны только для:
# ARTHUR_N8N_WORKFLOW=arthur-morning-task-brief-production

# ID уже созданного Telegram credential
# N8N_TELEGRAM_CREDENTIAL_ID=replace-with-credential-id

# Личный Telegram chat ID Сергея
# N8N_TELEGRAM_CHAT_ID=replace-with-chat-id

# Следующие параметры нужны только для:
# ARTHUR_N8N_WORKFLOW=arthur-minmax-yandex-mail-intake

# ID Header Auth credential «Purchasing API Token» (header x-api-key,
# значение = PURCHASING_API_TOKEN на Purchasing backend)
# N8N_PURCHASING_CREDENTIAL_ID=replace-with-credential-id

# ID IMAP credential «MinMax Yandex IMAP» (imap.yandex.ru:993, SSL,
# пароль приложения Яндекса)
# N8N_MINMAX_IMAP_CREDENTIAL_ID=replace-with-credential-id

# ID SMTP credential «MinMax Yandex SMTP» (smtp.yandex.ru:465, SSL,
# пароль приложения Яндекса)
# N8N_MINMAX_SMTP_CREDENTIAL_ID=replace-with-credential-id

# Fixed MinMax deployment (npm run arthur:minmax:deploy / :verify).
# Стабильный production ID; можно не задавать, это значение используется
# по умолчанию.
# N8N_MINMAX_WORKFLOW_ID=minmaxYandexIntakeFixed01
# Для Fixed workflow N8N_ARTHUR_CREDENTIAL_ID должен указывать на Header Auth
# credential «Arthur Core API» с header name x-api-key.
